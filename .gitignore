# Dependencies
node_modules/
.pnp
.pnp.js

# Build and Distribution Artifacts
dist/
dist-electron/
release/
build/
# Keep official packaging icons (generated from public/logo.png)
!build/icon.png
!build/icon.ico
!build/icons/
!build/icons/**
out/

# Application Logs & Diagnostics
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local SQLite Database Files & Caches
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
karaoke.sqlite
userData/
temp/

# Environment Variables & Secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE & Editor Configuration
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Platform binaries (downloaded during build, only .gitkeep tracked)
bin/*
!bin/.gitkeep
!bin/win/
bin/win/*
!bin/win/.gitkeep
!bin/linux/
bin/linux/*
!bin/linux/.gitkeep
!bin/mac/
bin/mac/*
!bin/mac/.gitkeep

